# Base URL of the backend API (no trailing slash), e.g. https://api.constantclean.com
# Leave empty while VITE_USE_MOCK_API=true.
VITE_API_URL=

# true  = use the in-browser mock services (localStorage, fake latency)
# false = call the real REST API at VITE_API_URL
VITE_USE_MOCK_API=true

# Stripe publishable key (unused for now — card / Google Pay go through Stripe in the backend phase)
VITE_STRIPE_PUBLISHABLE_KEY=
